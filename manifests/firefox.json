{
  "manifest_version": 3,
  "name": "Browser Mirror",
  "version": "1.0",
  "description": "Horizontally mirror the current tab or its main video area.",
  "author": "Tim Pyrkov",
  "homepage_url": "https://github.com/timpyrkov/browser-mirror",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Browser Mirror"
  },
  "sidebar_action": {
    "default_title": "Browser Mirror",
    "default_panel": "sidebar.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
